{
  "name": "praxis",
  "version": "1.3.0",
  "description": "7-stage LLM pipeline that turns a business question into a briefing in a declared format (Markdown, PDF, DOCX)",
  "author": "Matteo Gallo <matteogallo.office@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matteogallo-ai/praxis.git"
  },
  "homepage": "https://github.com/matteogallo-ai/praxis",
  "bugs": "https://github.com/matteogallo-ai/praxis/issues",
  "keywords": [
    "llm-pipeline",
    "briefings",
    "consulting",
    "analytical-writing",
    "format-registry",
    "typescript",
    "bun"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "praxis": "./src/cli/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome lint .",
    "knip": "knip",
    "check:claims": "bun run scripts/check-claims.ts",
    "check:stale-narrative": "bun run scripts/check-stale-narrative.ts",
    "check:commits": "bun run scripts/check-commits.ts",
    "cli": "bun run src/cli/index.ts",
    "bench": "bun run benchmarks/run-all.ts",
    "bench:mock": "bun run benchmarks/run-all.ts --mock-only",
    "bench:live": "bun run benchmarks/run-all.ts --live-only",
    "score": "bun run benchmarks/score-all.ts",
    "score:live": "bun run benchmarks/score-all.ts --live-only",
    "score:dry": "bun run benchmarks/score-all.ts --dry-run",
    "mutation": "git diff --quiet -- src && stryker run"
  },
  "dependencies": {
    "@promptlang/yaml-parser": "^1.0.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.6",
    "fast-check": "4.10.2",
    "knip": "6.44.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "qs": "6.17.1",
    "minimatch": "11.0.4"
  }
}
