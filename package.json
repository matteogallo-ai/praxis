{
  "name": "praxis",
  "version": "1.2.0",
  "description": "Format Registry for producing consultant-grade analytical briefings in the exact codes of the target organization",
  "author": "Matteo Gallo <matteo.gallo@gallarti.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matteogallo-ai/praxis.git"
  },
  "homepage": "https://github.com/matteogallo-ai/praxis",
  "bugs": "https://github.com/matteogallo-ai/praxis/issues",
  "keywords": [
    "multi-agent",
    "briefings",
    "consulting",
    "analytical-writing",
    "format-registry",
    "typescript",
    "bun"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "praxis": "./src/cli/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "cli": "bun run src/cli/index.ts",
    "bench": "bun run benchmarks/run-all.ts",
    "bench:mock": "bun run benchmarks/run-all.ts --mock-only",
    "bench:live": "bun run benchmarks/run-all.ts --live-only",
    "score": "bun run benchmarks/score-all.ts",
    "score:mock": "bun run benchmarks/score-all.ts --mock-only",
    "score:live": "bun run benchmarks/score-all.ts --live-only",
    "score:dry": "bun run benchmarks/score-all.ts --dry-run"
  },
  "dependencies": {
    "@promptlang/yaml-parser": "^1.0.0",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
