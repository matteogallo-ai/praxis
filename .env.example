# Praxis — environment configuration example.
#
# Copy this file to `.env` and fill in the values below. `.env` is
# git-ignored; never commit real API keys.
#
#   cp .env.example .env
#   $EDITOR .env

# Anthropic API key — required to run the CLI with `--provider anthropic`
# and to unlock the live integration tests under `tests/live/`.
# Obtain one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=your-key-here

# Optional — override the default Anthropic model. Defaults to
# `claude-sonnet-4-5` when unset. Any model id accepted by the
# Anthropic Messages API works.
# ANTHROPIC_MODEL=claude-sonnet-4-5
