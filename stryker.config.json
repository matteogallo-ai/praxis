{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "The command runner keeps Stryker on bun test without a third-party runner.",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test tests/orchestrator tests/sourcing tests/agents tests/property --bail"
  },
  "checkers": [],
  "mutate": [
    "src/orchestrator/orchestrator.ts",
    "src/sourcing/validator.ts",
    "src/sourcing/freshness.ts",
    "src/sourcing/domain-trust.ts",
    "src/agents/prompt-runtime.ts:304-497",
    "src/agents/synthesis.ts:697-787"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": null },
  "concurrency": 8,
  "timeoutMS": 20000,
  "cleanTempDir": "always"
}
